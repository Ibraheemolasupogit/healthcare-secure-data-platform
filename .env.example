HEALTHCARE_PLATFORM_ENV=local
HEALTHCARE_PLATFORM_EXECUTION_MODE=local
HEALTHCARE_PLATFORM_LOG_LEVEL=INFO

# Milestone 10 Airflow orchestration defaults. Fixture mode is credential-free.
HEALTHCARE_AIRFLOW_EXECUTION_MODE=fixture
HEALTHCARE_AIRFLOW_REPOSITORY_ROOT=/workspace
HEALTHCARE_AIRFLOW_OUTPUT_ROOT=outputs/orchestration
HEALTHCARE_AIRFLOW_PROFILE=small
HEALTHCARE_AIRFLOW_SEED=42
HEALTHCARE_AIRFLOW_REFERENCE_DATE=2025-01-01
HEALTHCARE_AIRFLOW_SOURCE_DATA_PATH=data/samples/small
HEALTHCARE_AIRFLOW_INTEROPERABILITY_PATH=data/samples/interoperability
HEALTHCARE_AIRFLOW_ASSURANCE_EVIDENCE_OUTPUT=outputs/orchestration/assurance
HEALTHCARE_AIRFLOW_DBT_PROJECT_DIR=dbt
HEALTHCARE_AIRFLOW_DBT_PROFILES_DIR=dbt
HEALTHCARE_AIRFLOW_DBT_TARGET=dev
HEALTHCARE_AIRFLOW_CONNECTED_SNOWFLAKE=false
HEALTHCARE_AIRFLOW_ALLOW_LARGE_GENERATION=false
HEALTHCARE_AIRFLOW_OVERWRITE=false
HEALTHCARE_AIRFLOW_RETRY_COUNT=1
HEALTHCARE_AIRFLOW_RETRY_DELAY_SECONDS=60
HEALTHCARE_AIRFLOW_EXECUTION_TIMEOUT_MINUTES=30
HEALTHCARE_AIRFLOW_SENSOR_TIMEOUT_SECONDS=30
HEALTHCARE_AIRFLOW_SENSOR_POKE_INTERVAL_SECONDS=5
HEALTHCARE_AIRFLOW_CATCHUP=false
HEALTHCARE_AIRFLOW_MAX_ACTIVE_RUNS=1
HEALTHCARE_AIRFLOW_ENABLE_NOTIFICATIONS=false

# Future Snowflake variables; leave unset for local and fixture execution.
# Placeholder names only. Do not put real tenant IDs, account identifiers, passwords,
# private keys, tokens, certificates or connection strings in this file.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_PRIVATE_KEY_PATH=
