  "tags": {
    "SENSITIVITY_CLASS": {
      "database": "GOVERNANCE",
      "schema": "SECURITY",
      "owner_role": "GOVERNANCE_OWNER",
      "purpose": "Future classification attachment point; no masking policy is implied.",
      "allowed_values": ["DIRECT_IDENTIFIER", "INDIRECT_IDENTIFIER", "CLINICAL_CONFIDENTIAL", "FINANCIAL_CONFIDENTIAL", "OPERATIONAL", "RESEARCH_PSEUDONYMISED", "PUBLIC_REFERENCE"]
    }
  },
  "ownership_matrix": {
    "Terraform": ["DATABASE", "SCHEMA", "WAREHOUSE", "RESOURCE_MONITOR", "ACCOUNT_ROLE", "ROLE_GRANT", "PRIVILEGE_GRANT", "TAG"],
    "SQL_VALIDATION": ["OBJECT_INVENTORY_QUERY", "ROLE_HIERARCHY_QUERY", "GRANT_QUERY", "RBAC_EXPECTATION_QUERY", "MONITORING_QUERY"],
    "DBT_FUTURE": ["TABLE", "VIEW", "DYNAMIC_TABLE", "SNAPSHOT", "MART", "SEMANTIC_DEFINITION"],
    "RUNTIME_FUTURE": ["TEMPORARY_OBJECT", "QUERY_HISTORY", "TASK_RUN_HISTORY", "LOAD_HISTORY"]
  },
  "rbac_expectations": {
    "positive": [
      "ANALYTICS_ENGINEER can use TRANSFORM_WH and create dbt-owned objects in approved CURATED schemas.",
      "BI_CONSUMER can use BI_WH and read future objects in SERVING.BI.",
      "AUDITOR can use ADMIN_WH and inspect approved GOVERNANCE metadata."
    ],
    "negative": [
      "BI_CONSUMER cannot create or modify objects.",
      "RESEARCHER cannot access RAW.CLINICAL or patient-identity landing zones.",
      "FINANCE_ANALYST cannot access RAW.CLINICAL.",
      "SERVICE_INGEST cannot create or query CURATED or SERVING objects.",
      "DEV roles cannot access TEST or PROD databases or warehouses."
    ]
  }
